# Copy this file to .env and fill in your own values. Never commit .env.
GROQ_API_KEY=your_value_here

# Embedding model (runs locally via sentence-transformers, no API key needed)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Groq model used for answer generation
LLM_MODEL=openai/gpt-oss-120b

# Where uploaded PDFs and the vector store live
UPLOAD_DIR=data/uploads
VECTORSTORE_DIR=data/vectorstore
